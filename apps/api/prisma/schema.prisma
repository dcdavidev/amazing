generator client {
  provider = "prisma-client"
  output   = "../src/models/prisma"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id        String          @id @default(uuid())
  name      String
  offers    SupplierOffer[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Supplier {
  id            String          @id @default(uuid())
  name          String
  minDaysToShip Int
  offers        SupplierOffer[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model SupplierOffer {
  id            String         @id @default(uuid())
  supplierId    String
  articleId     String
  unitPrice     Float
  stockQuantity Int
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  article       Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  discountRules DiscountRule[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([supplierId, articleId])
}

model DiscountRule {
  id          String        @id @default(uuid())
  offerId     String
  type        String // "MIN_TOTAL_AMOUNT" | "MIN_QUANTITY" | "MONTH_PERIOD"
  percentage  Float
  minAmount   Float?
  minQuantity Int?
  month       Int? // 1 = January, 9 = September, 11 = November
  offer       SupplierOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
