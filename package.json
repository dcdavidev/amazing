{
  "name": "amazing",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "fmt": "pnpm exec prettier --ignore-unknown --write .",
    "lint": "pnpm exec eslint --no-warn-ignored --fix .",
    "lint:fmt": "pnpm run lint && pnpm run fmt"
  },
  "commitlint": {
    "extends": [
      "spellbookx"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "prettier": "prettier-config-spellbookx/astro-prisma",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.20.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@prettier/plugin-xml": "^3.4.2",
    "commitlint-config-spellbookx": "^0.11.1",
    "cz-git": "^1.14.0",
    "eslint": "10.9.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-node-dependencies": "^2.2.0",
    "eslint-plugin-package-json": "^1.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-vuoto": "^0.1.2",
    "globals": "17.12.0",
    "jsonc-eslint-parser": "^3.3.0",
    "prettier": "3.9.6",
    "prettier-config-spellbookx": "^0.11.1",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.19.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-toml": "^2.0.6",
    "prisma": "8.0.0-rc.15",
    "turbo": "^2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vuoto": "^0.1.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/composer": "0.20.0",
    "@prisma/composer-prisma-cloud": "0.20.0",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/platform-node": "4.0.0-rc.112",
      "@effect/platform-node-shared": "4.0.0-rc.112",
      "@effect/sql-d1": "4.0.0-rc.112",
      "@effect/sql-pg": "4.0.0-rc.112",
      "@effect/vitest": "4.0.0-rc.112",
      "effect": "4.0.0-rc.112"
    }
  }
}
